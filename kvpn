def choose(prompt, options, default_index=0):
    print("\n  " + prompt)
    for i, opt in enumerate(options):
        marker = " (default)" if i == default_index else ""
        print("    %d  %s%s" % (i + 1, opt, marker))
    while True:
        raw = input("  Choose [%d]: " % (default_index + 1)).strip()
        if not raw:
            return options[default_index]
        if raw.isdigit() and 1 <= int(raw) <= len(options):
            return options[int(raw) - 1]
        print("  Please enter a number between 1 and %d." % len(options))


def authenticate_and_connect(manager, args):
    title()
    stored = load_credentials()
    if stored:
        username, password, realm = stored
        row('Account', username)
        row('Realm', realm)
        row('Credentials', 'Saved in Keychain')
    else:
        if getattr(args, "sms_auto", False):
            raise KvpnError("Save VPN credentials with kvpn on before using SMS automation.")
        default_user = os.environ.get("KVPN_USER", "")
        username = input("KAIST ID%s: " % (" [%s]" % default_user if default_user else "")).strip() \
            or default_user
        if not username:
            raise KvpnError("A KAIST ID is required.")
        password = getpass.getpass("Password: ")
        if not password:
            raise KvpnError("A password is required.")
        realm = choose("Realm:", REALMS, 0)

    ivanti = Ivanti()
    welcome = ivanti.begin()

    portal = Portal(welcome)
    portal.begin(username)

    automatic = getattr(args, "sms_auto", False)
    reader = SMSReader() if automatic else None
    sender = args.sms_sender if automatic else None
    baseline = reader.baseline() if automatic else None
    send_type = "sms" if automatic else ("sms" if choose("Send code via:", ["SMS", "Email"], 0) == "SMS" else "email")
    if getattr(args, "cancelled", lambda: False)():
        raise KvpnError("Automatic login stopped before SMS request.")
    portal.send_code(username, send_type)
    row('Verification', 'Waiting for SMS…' if automatic else 'Code sent via ' + send_type.upper(), '33')

    otp = reader.wait(sender, baseline, cancelled=getattr(args, "cancelled", lambda: False)) if automatic else input("  Verification code: ").strip()
    if not otp:
        raise KvpnError("A code is required.")

    if getattr(args, "cancelled", lambda: False)():
        raise KvpnError("Automatic login stopped before submission.")
    password2 = portal.verify(username, otp)
    try:
        dsid = ivanti.finish(username, password, realm, password2, unattended=automatic,
                             replace_existing=manager.session_replacement_allowed())
        authenticated_at = time.time()
    except ExistingSessionError:
        raise
    except KvpnError as e:
        if stored:
            raise KvpnError("%s\nIf your KAIST password changed, run `kvpn --forget` "
                            "and log in again." % e)
        raise
    row('Sign-in', 'Verified', '32')

    if not stored:
        offer_to_save(username, password, realm)

    try:
        from kvpn_timing import observe
        observe(ivanti.opener, authenticated_at)
    except Exception:
        print('Gateway session limit unavailable; status will retain an explicit estimate.')
    if args.inspect_session:
        from kvpn_session import probe
        try:
            probe(ivanti)
            from kvpn_session_channel import start
            start(dsid)
            print('Read-only in-memory session channel available for 20 minutes.')
        except Exception as error:
            print('Session discovery unavailable:', type(error).__name__)
    if getattr(args, "cancelled", lambda: False)():
        raise KvpnError("Automatic login stopped before tunnel launch.")
    rc = manager.launch(dsid, authenticated_at=authenticated_at, foreground=args.foreground, reconnect_timeout=args.reconnect_timeout, estimate_hours=args.estimate_hours, unattended=automatic, supervised=getattr(args, 'command', None) == 'auto')
    if rc:
        raise KvpnError("OpenConnect exited unsuccessfully.")
    return rc


class KVPNParser(argparse.ArgumentParser):
    def error(self, message):
        import difflib
        match = re.search(r"invalid choice: '([^']*)'", message)
        if match:
            command = match.group(1)
            message = f"Unknown command: {command}"
            suggestion = difflib.get_close_matches(command, ['setup', 'connect', 'disconnect', 'auto', 'status', 'doctor', 'logs', 'config', 'help', 'on', 'off'], n=1, cutoff=0.6)
            hint = f"Try: kvpn {suggestion[0]}" if suggestion else 'Use: kvpn | kvpn off | kvpn status'
        else:
            hint = 'Run kvpn --help for usage.'
        self.exit(2, f"\n  {color(message, '31')}\n  {color(hint, '36')}\n\n")

    def print_help(self, file=None):
        file = sys.stdout if file is None else file
        if self.advanced_help:
            return super().print_help(file)
        self._print_message(
            "\n  " + color('KVPN', '1;36') + "  KAIST VPN\n\n"
            + command_help() + "\n\n  " + color('More options: kvpn --help-all', '2') + "\n\n", file)



def main(argv):
    advanced = '--help-all' in argv
    argv = ['--help' if arg == '--help-all' else arg for arg in argv]
    parser = KVPNParser(description="KAIST VPN CLI: background connection and explicit lifecycle control.")
    parser.advanced_help = advanced
    parser.add_argument('command', nargs='?', choices=['help', 'setup', 'doctor', 'config', 'check', 'on', 'off', 'connect', 'status', 'disconnect', 'log', 'logs', 'forget', 'auto', 'auto-stop', 'sms-check'], default='auto', metavar='COMMAND', help='setup, connect, auto, disconnect, status, doctor, logs, config, help; legacy aliases retained')
    parser.add_argument('action', nargs='?', choices=['start', 'stop', 'status'], help='auto subcommand')
    parser.add_argument('--session-replacement', choices=['ask', 'allow'], help='With config: require confirmation or allow replacing another gateway session')
    parser.add_argument('--sms-auto', action='store_true', help='Read a fresh KAIST code from local Messages; requires saved credentials')
    parser.add_argument('--sms-sender', help='Exact verified KAIST SMS sender; otherwise discover from recent matching messages')
    parser.add_argument('--version', action='version', version=VERSION)
    parser.add_argument('--forget', action='store_true', help='Remove saved credentials')
    parser.add_argument('--inspect-session', action='store_true', help='Read-only discovery of gateway session timing/extension UI after login')
    parser.add_argument('--foreground', action='store_true', help='Keep VPN attached to this terminal')
    parser.add_argument('--json', action='store_true', help='Machine-readable status')
    parser.add_argument('--reconnect-timeout', type=int, default=300, metavar='SECONDS', help='Native transport retry window, 1–3600 seconds (default 300); not session renewal')
    parser.add_argument('--estimate-hours', type=int, default=10, metavar='HOURS', help='Unverified session lifetime estimate, 1–24 hours (default 10)')
    args = parser.parse_args(argv)
    if args.action:
        if args.command != 'auto':
            parser.error('Only auto accepts start, stop or status.')
        args.command = {'start': 'auto', 'stop': 'auto-stop', 'status': 'status'}[args.action]
    if args.session_replacement is not None and args.command != 'config':
        parser.error('--session-replacement requires the config command.')
    if args.json and args.command not in ('status', 'check', 'doctor', 'config'):
        parser.error('--json is supported by status, doctor, check and config.')
    if args.command == 'help':
        parser.print_help()
        return
    if args.command == 'on':
        args.command = 'connect'  # Keep the legacy spelling as a compatibility alias.
    if args.command == 'log':
        args.command = 'logs'
    if args.command == 'off':
        args.command = 'disconnect'
    if args.forget:
        args.command = "forget"
    if not 1 <= args.reconnect_timeout <= 3600 or not 1 <= args.estimate_hours <= 24:
        parser.error('Retry window must be 1–3600 seconds and lifetime estimate 1–24 hours.')
    if sys.platform != 'darwin' and (args.command in ('auto', 'sms-check') or args.sms_auto):
        raise KvpnError('Automatic SMS verification requires macOS Messages. Use kvpn connect for experimental manual login on Linux.')
    manager = Manager()
    if args.command == 'setup':
        from kvpn_setup import guide
        guide(manager)
        return
    if args.command == 'config':
        if args.session_replacement is not None:
            manager.set_session_replacement(args.session_replacement == 'allow')
        value = {'session_replacement': 'allow' if manager.session_replacement_allowed() else 'ask'}
        if args.json:
            print(json.dumps(value))
        else:
            row('Session policy', value['session_replacement'])
            note('Allow can disconnect another device using the same KAIST account.' if value['session_replacement'] == 'allow' else 'Manual login asks; automatic login stops when another gateway session needs replacement.')
        return
    if args.command in ('check', 'doctor'):
        from kvpn_check import check, display
        results = check(manager)
        print(json.dumps(results, indent=2)) if args.json else display(results)
        if any(item['status'] == 'error' for item in results):
            raise SystemExit(1)
        return
    if args.command == 'auto-stop':
        from kvpn_auto import request_stop
        request_stop(manager)
        print('Automatic recovery stop requested; existing VPN retained.')
        return
    if args.command == 'disconnect':
        from kvpn_auto import request_stop
        request_stop(manager)
    if args.command == 'sms-check':
        reader = SMSReader()
        reader.diagnostics()
        sender = args.sms_sender or reader.discover_sender()
        print('Messages access OK. Verified sender candidate:', sender)
        print('No message body or code printed; no SMS requested.')
        return
    if args.command == 'auto':
        from kvpn_auto import auto_status
        if auto_status(manager).get('running'):
            row('Auto recovery', 'Already running', '32')
            note('Use kvpn status to check or kvpn off to stop.')
            return
        if not shutil.which('openconnect'):
            raise KvpnError('OpenConnect not found. Install it before starting automatic recovery.')
        args.sms_auto = True
    if args.sms_auto and args.command in ('connect', 'auto'):
        if args.foreground or args.inspect_session:
            parser.error('SMS automation cannot be combined with foreground tunnel or session inspection.')
        reader = SMSReader()
        reader.baseline()
        args.sms_sender = args.sms_sender or reader.discover_sender()
        if not load_credentials():
            raise KvpnError('Saved credentials are required. Run kvpn connect once to save your credentials.')
    if args.command == 'auto':
        if not sys.stdin.isatty():
            raise KvpnError('Start kvpn in Terminal for initial administrator authorization.')
        current = manager.status()
        if current['unmanaged_pids']:
            raise KvpnError('Unmanaged VPN detected; no automatic login attempted.')
        subprocess.run(['sudo', '-v'], check=True)
        from kvpn_auto import supervise
        supervise(manager,args,authenticate_and_connect)
        return
    if args.command == 'status':
        value = manager.status()
        from kvpn_auto import auto_status
        value['automatic_reconnect'] = auto_status(manager)
        print(json.dumps(value, indent=2)) if args.json else display_status(value)
        return
    if args.command == 'logs':
        print(manager.logs() or 'No managed connection log yet.')
        return
    with manager.lock():
        if args.forget or args.command == 'forget':
            if not forget_credentials():
                print('No stored credentials found.')
            return
        if args.command == 'disconnect':
            manager.disconnect()
            return
        manager.assert_idle()
        if not shutil.which('openconnect'):
            raise KvpnError('OpenConnect not found. Install it with brew install openconnect.')
        if not sys.stdin.isatty():
            raise KvpnError('Fresh login requires an interactive terminal and OTP. No automatic login was attempted.')
        subprocess.run(['sudo', '-v'], check=True)
        authenticate_and_connect(manager, args)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except (KvpnError, SMSError, LifecycleError, OSError, subprocess.SubprocessError) as e:
        print("\n  " + color("Error: " + redact(str(e)), "31") + "\n", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        print("\n  " + color("Cancelled.", "33") + "\n", file=sys.stderr)
        sys.exit(130)
