class KvpnError(Exception):
    """A user-facing failure with a clear message."""


class ExistingSessionError(KvpnError):
    """Gateway requires explicit confirmation before replacing a session."""


# --------------------------------------------------------------------------
# HTTP plumbing
# --------------------------------------------------------------------------
def new_session():
    """Return (opener, cookiejar) with its own cookie store."""
    cj = http.cookiejar.CookieJar()
    opener = urllib.request.build_opener(
        urllib.request.HTTPCookieProcessor(cj),
        urllib.request.HTTPSHandler(context=ssl.create_default_context()),
    )
    opener.addheaders = [("User-Agent", UA)]
    return opener, cj


def http_get(opener, url, referer=None):
    req = urllib.request.Request(url)
    if referer:
        req.add_header("Referer", referer)
    with opener.open(req, timeout=30) as r:
        return r.geturl(), r.read().decode("utf-8", "replace")


def http_post(opener, url, data, referer=None):
    body = urllib.parse.urlencode(data).encode()
    req = urllib.request.Request(url, data=body)
    req.add_header("Content-Type", "application/x-www-form-urlencoded")
    if referer:
        req.add_header("Referer", referer)
    with opener.open(req, timeout=30) as r:
        return r.geturl(), r.read().decode("utf-8", "replace")


def cookie_value(cj, name):
    for c in cj:
        if c.name == name:
            return c.value
    return None


class _NoAutoRedirect(urllib.request.HTTPErrorProcessor):
    """Return 3xx/4xx responses instead of raising or auto-following them,
    so a redirect chain can be walked by hand (cookies still update)."""
    def http_response(self, request, response):
        return response
    https_response = http_response


# --------------------------------------------------------------------------
# Ivanti side
# --------------------------------------------------------------------------
class _GatewayForms(HTMLParser):
    """Read form controls without evaluating gateway JavaScript."""
    def __init__(self):
        super().__init__()
        self.forms = []
        self.current = None

    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        if tag == 'form':
            self.current = {'action': attrs.get('action', ''),
                            'method': attrs.get('method', 'get').lower(),
                            'hidden': {}, 'submit': {}}
            self.forms.append(self.current)
        elif tag == 'input' and self.current is not None and 'disabled' not in attrs:
            kind = attrs.get('type', '').lower()
            name = attrs.get('name')
            if name and kind in ('hidden', 'submit'):
                self.current[kind][name] = attrs.get('value', '')

    def handle_endtag(self, tag):
        if tag == 'form':
            self.current = None


class Ivanti:
    def __init__(self):
        self.opener, self.cj = new_session()
        self.welcome_url = None
        self.login_url = None

    def begin(self):
        """Step 1: land on the sign-in page, capture the login endpoint."""
        url, html = http_get(self.opener, IVANTI + "/")
        forms = _GatewayForms()
        forms.feed(html)
        notices = [f for f in forms.forms if 'sn-preauth-proceed' in f['submit']]
        if notices:
            if len(notices) != 1:
                raise KvpnError("Ambiguous Ivanti pre-sign-in notification; stopped before login.")
            form = notices[0]
            action = urllib.parse.urljoin(url, form['action'])
            target = urllib.parse.urlsplit(action)
            origin = urllib.parse.urlsplit(IVANTI)
            if (form['method'] != 'post' or target.scheme != origin.scheme
                    or target.netloc != origin.netloc
                    or not re.fullmatch(r'/dana-na/auth/(?:url_[^/]+/)?welcome\.cgi', target.path)):
                raise KvpnError("Unexpected Ivanti notification destination; stopped before login.")
            row('Gateway', 'Continuing past pre-sign-in notification')
            data = dict(form['hidden'])
            data['sn-preauth-proceed'] = form['submit']['sn-preauth-proceed']
            url, html = http_post(self.opener, action, data, referer=url)
            # One acknowledgement only: never loop through notices or request OTPs here.
            if urllib.parse.urlsplit(url).netloc != origin.netloc or urllib.parse.urlsplit(url).scheme != origin.scheme:
                raise KvpnError("Unexpected redirect after Ivanti notification; stopped before login.")
        self.welcome_url = url
        m = re.search(r'action=["\']([^"\']*login\.cgi)["\']', html, re.I)
        if not m:
            m = re.search(r'(/dana-na/auth/url_[^/"\']+/login\.cgi)', html)
        if not m:
            raise KvpnError("Ivanti did not return a login form" +
                            (" after the pre-sign-in notification." if notices else ".") +
                            " The gateway may be showing a notice, maintenance or an unsupported page; no SMS requested.")
        self.login_url = urllib.parse.urljoin(url, m.group(1))
        if urllib.parse.urlsplit(self.login_url)[:2] != urllib.parse.urlsplit(IVANTI)[:2]:
            raise KvpnError("Unexpected Ivanti login destination; stopped before login.")
        return self.welcome_url

    def finish(self, username, password, realm, password2, unattended=False, replace_existing=False):
        """Step 7: submit primary + secondary credentials, return the DSID."""
        final_url, body = http_post(self.opener, self.login_url, {
            "tz_offset": "540",
            "username": username,
            "password": password,
            "realm": realm,
            "password#2": password2,
        }, referer=self.welcome_url)
        if "p=failed" in final_url or "p=locked" in final_url:
            raise KvpnError("Ivanti rejected the final login (bad password, or the "
                            "sign-in session expired while entering the code).")
        if "p=user-confirm" in final_url or 'name="frmConfirmation"' in body:
            # Active-session confirmation page: the account already has a live
            # session, and the gateway wants a "Continue" click before issuing
            # a DSID. Submit the confirmation form like the browser would.
            if not replace_existing and (unattended or not sys.stdin.isatty() or input(
                "Another session is active. Continuing may replace it. Continue? [y/N]: "
            ).strip().lower() not in ("y", "yes")):
                raise ExistingSessionError("Existing session retained; login cancelled.\n"
                                           "The gateway reports another active session. Run `kvpn on` "
                                           "and confirm replacement if it is your previous connection.")
            if replace_existing:
                row("Session", "Replacing previous gateway session", "33")
            final_url, body = self._confirm_continue(final_url, body)
            if "p=user-confirm" in final_url or 'name="frmConfirmation"' in body:
                raise ExistingSessionError("Gateway did not accept session replacement; stopped without retrying SMS.")
        dsid = cookie_value(self.cj, "DSID")
        if not dsid:
            raise KvpnError("Login did not yield a DSID cookie (unexpected server response "
                            "at %s)." % final_url)
        self.final_url, self.final_body = final_url, body
        return dsid

    def _confirm_continue(self, page_url, body):
        """Submit the frmConfirmation page (btnContinue + hidden fields)."""
        data = {}
        btn = None
        for tag in re.findall(r"<input\b[^>]*>", body, re.I):
            name = re.search(r'name=["\']([^"\']+)["\']', tag, re.I)
            value = re.search(r'value=["\']([^"\']*)["\']', tag, re.I)
            typ = re.search(r'type=["\']([^"\']+)["\']', tag, re.I)
            if not name:
                continue
            typ = typ.group(1).lower() if typ else "text"
            if typ == "hidden":
                data[name.group(1)] = value.group(1) if value else ""
            elif typ == "submit" and name.group(1).lower() == "btncontinue":
                btn = (name.group(1), value.group(1) if value else "Continue")
        if btn is None:
            btn = ("btnContinue", "Continue the session")
        data[btn[0]] = btn[1]
        if os.environ.get("KVPN_DEBUG"):
            print("  [confirm] posting %s to login.cgi" % sorted(data))
        return http_post(self.opener, self.login_url, data, referer=page_url)


